{
  "name": "tideborn",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build && node tools/build-offline.mjs",
    "build:web": "node tools/build-web.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:web": "wrangler dev --local --ip 127.0.0.1 --var LEADERBOARD_SIGNING_KEY:tideborn-local-preview-only",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "three": "^0.181.1",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "vite": "^7.2.2",
    "wrangler": "4.162.0"
  },
  "license": "MIT"
}
